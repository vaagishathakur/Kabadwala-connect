{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://kabadwala-connect-api.onrender.com/api/:match*"
    },
    {
      "source": "/ml/:match*",
      "destination": "https://kabadwala-connect-ml.onrender.com/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
